# Optional local service settings.
SUPER_AGENT_APP_NAME=super-ai-agent
SUPER_AGENT_VERSION=0.1.0.dev0
SUPER_AGENT_HOST=127.0.0.1
SUPER_AGENT_PORT=8000

# Optional OpenAI-compatible model gateway for real integration tests.
# Examples: https://api.openai.com/v1, https://api.deepseek.com/v1,
# http://localhost:11434/v1 (Ollama), or a local OpenRouter-compatible proxy.
SUPER_AGENT_BASE_URL=
SUPER_AGENT_API_KEY=
SUPER_AGENT_MODEL=
SUPER_AGENT_MODEL_TIMEOUT_SECONDS=60

# Optional Magpie local gateway (default: http://127.0.0.1:3425/v1).
SUPER_AGENT_MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
SUPER_AGENT_MAGPIE_API_KEY=magpie-super-ai-agent

# Root exposed to the built-in file tools. Keep it on a trusted workspace.
SUPER_AGENT_WORKSPACE_ROOT=.

# Per-task artifact folders. Every task writes into
# <workspace_root>/<cache dir>/<task id>-<title>/, so generated files never
# pile up in the repository root. Set SUPER_AGENT_TASK_WORKSPACES=0 to go
# back to writing anywhere in the workspace.
SUPER_AGENT_TASK_WORKSPACES=1
SUPER_AGENT_CACHE_DIR_NAME=项目缓存文件

# Optional HMAC secret for /api/webhooks/{source}. Set this in production.
SUPER_AGENT_WEBHOOK_SECRET=


# Resident Router batching: max pending cold-start triggers merged per drain.
SUPER_AGENT_ROUTER_BATCH_LIMIT=8

# Silently pre-compute drafts for signal-like events (bug/会议/报错...);
# results are delivered only after POST /api/speculations/{id}/promote.
SUPER_AGENT_SPECULATIVE_ENABLED=

# Run the Watchdog control loop inside the API process every N seconds (0=off).
SUPER_AGENT_WATCHDOG_INTERVAL_SECONDS=0

# Upper bound on model calls per Worker turn (tool rounds). Raise for tasks
# that need many file reads; lower to fail fast on runaway loops.
SUPER_AGENT_WORKER_MAX_ROUNDS=12

# User-loaded tools (see docs/custom-tools.md).
# Manifest: JSON file with {"tools": [...]} (defaults to ./tools.json if present).
SUPER_AGENT_TOOL_MANIFEST=
# Comma-separated module:attr entries, e.g. my_pkg.tools:make_tool
SUPER_AGENT_TOOL_MODULES=
# os.pathsep-separated .py files or directories scanned for top-level *.py
SUPER_AGENT_TOOL_PATHS=
